# This file is used for Git repositories to specify intentionally untracked files that Git should ignore. 
# If you are not using git, you can delete this file. For more information see: https://git-scm.com/docs/gitignore
# For useful gitignore templates see: https://github.com/github/gitignore

# Salesforce cache
.sf/
.sfdx/
.localdevserver/
deploy-options.json

# LWC VSCode autocomplete
**/lwc/jsconfig.json

# LWC Jest coverage reports
coverage/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependency directories
node_modules/

# ApexPMD cache
.pmdCache

# Eslint cache
.eslintcache

# MacOS system files
.DS_Store

# Windows system files
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Local environment variables
.env

# Python Salesforce Functions
**/__pycache__/
**/.venv/
**/venv/

# Integration_Secret__mdt RECORDS carry webhook signing secrets. Added before any record
# existed - once a secret is committed, gitignore cannot help. Narrowed in build 08 from the whole
# customMetadata/ folder to this one type: Board_Source and Field_Mapping records hold no secret,
# and ignoring them made them click-only setup that no fresh org could reproduce.
force-app/main/default/customMetadata/Integration_Secret.*

# Commit message drafts, written per build step. Ephemeral - not part of the source.
.commit-messages/
