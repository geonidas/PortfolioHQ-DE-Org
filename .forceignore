package.xml

# LWC configuration files
**/jsconfig.json
**/.eslintrc.json

# LWC Jest
**/__tests__/**

node_modules/

# Custom metadata RECORDS carry secrets (Integration_Secret__mdt.Jira_Webhook).
# Ignored before any record exists: gitignore cannot untrack a file that was already
# committed, so the ordering here is the whole point.
force-app/main/default/customMetadata/
